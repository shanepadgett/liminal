  },
  "devDependencies": {
    "@effect/tsgo": "0.56.0",
    "@oxlint/plugins": "1.89.0",
    "@types/bun": "1.4.3",
    "fallow": "3.34.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "overrides": {
    "effect": "4.0.5"
  }
}
