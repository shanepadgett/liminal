{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    // Solid's JSX element type names DOM types such as Node, so tui entries need DOM types.
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "plugins": [{ "name": "@effect/language-service", "diagnostics": false }]
  },
  "include": ["apps", "packages", "tools"],
  // The gallery has its own config: apps/gallery/tsconfig.json.
  "exclude": ["**/node_modules", "tools/**/fixtures", "archive", "apps/gallery"]
}
