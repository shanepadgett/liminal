{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    // Solid's JSX element type names DOM types such as Node, so the gallery's .tsx needs DOM.
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "plugins": [{ "name": "@effect/language-service", "diagnostics": false }]
  },
  "include": ["apps", "kernel", "sdk", "plugins", "tools"],
  "exclude": ["**/node_modules", "tools/**/fixtures"]
}
