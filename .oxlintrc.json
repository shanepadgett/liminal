{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": ["./tools/lint/liminal-plugin.ts"],
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "error" },
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "ignorePatterns": ["tools/**/fixtures/**", "docs/reference/copies/**", "archive/**"],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/consistent-type-assertions": [
      "error",
      { "assertionStyle": "as", "objectLiteralTypeAssertions": "never" }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "eqeqeq": "error",
    "no-nested-ternary": "error",
    "no-negated-condition": "error",
    "no-lonely-if": "error",
    "no-else-return": "error",
    "no-param-reassign": ["error", { "props": true }],
    "no-useless-return": "error",
    "no-unneeded-ternary": "error",
    "no-warning-comments": "error",
    "preserve-caught-error": "error",
    "prefer-const": "error",
    "max-depth": ["error", 3],
    "max-params": ["error", 4],
    "complexity": ["error", 10],
    "max-lines-per-function": [
      "error",
      { "max": 60, "skipBlankLines": true, "skipComments": true }
    ],
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-reduce": ["error", { "allowSimpleOperations": true }],
    "unicorn/no-useless-undefined": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/prefer-node-protocol": "error",
    "oxc/no-accumulating-spread": "error",
    "liminal/contract-imports": "error",
    "liminal/contract-no-side-effects": "error",
    "liminal/manifest-imports": "error",
    "liminal/part-isolation": "error",
    "liminal/server-imports": "error",
    "liminal/testing-imports": "error",
    "liminal/conformance-imports": "error",
    "liminal/no-unknown-parameters": "error",
    "liminal/no-unknown-returns": "error",
    "liminal/no-unknown-type-aliases": "error",
    "liminal/no-object-parameters": "error",
    "liminal/no-loose-dictionaries": "error",
    "liminal/no-chained-assertions": "error",
    "liminal/assertion-needs-reason": "error",
    "liminal/no-widen-then-assert": "error",
    "liminal/no-narration-comments": "error",
    "liminal/no-placeholder-comments": "error",
    "liminal/no-divider-comments": "error",
    "liminal/no-commented-code": "error",
    "liminal/no-jargon": "error",
    "liminal/no-em-dash": "error",
    "liminal/max-comment-words": "error",
    "liminal/prefer-jsdoc": "error",
    "liminal/disable-needs-reason": "error",
    "liminal/no-filter-map": "error",
    "liminal/padding-lines": "error",
    "liminal/no-conditional-empty-spread": "error",
    "liminal/no-module-mocking": "error",
    "liminal/no-reflect": "error",
    "liminal/no-manual-tag-check": "error",
    "liminal/no-manual-tagged-object": "error",
    "effecttsgo/unstable-api-usage": "off"
  },
  "overrides": [
    { "files": ["packages/**", "apps/**"], "rules": { "liminal/no-runtime-typeof": "error" } },
    { "files": ["packages/**"], "rules": { "liminal/no-effect-run": "error" } },
    {
      "files": ["**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": { "liminal/no-effect-run": "off", "max-lines-per-function": "off" }
    }
  ]
}
