{
  "$schema": "./node_modules/fallow/schema.json",
  // Fallow owns dead code, workspace dependency hygiene, cycles, import boundaries and duplicates.
  "ignorePatterns": ["tools/**/fixtures/**", "docs/reference/copies/**"],
  "entry": [
    "tools/quiet.ts",
    "tools/checks/plugin-anatomy.ts",
    "tools/reference/sync.ts",
    "tools/reference/check.ts",
    // The supervisor runs it as a child process by path.
    "apps/cli/src/main.ts",
    "apps/gallery/src/main.tsx",
    "apps/gallery/src/watch.ts",
  ],
  // Published APIs: the SDK for plugin authors, and every plugin's manifest and contract.
  "publicPackages": ["@liminal/sdk", "@liminal/*"],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "policy-violation": "error",
  },
  "duplicates": { "mode": "mild", "minTokens": 50, "minLines": 5, "minOccurrences": 2 },
  "boundaries": {
    "zones": [
      { "name": "apps", "patterns": ["apps/**"] },
      { "name": "kernel", "patterns": ["packages/kernel/**"] },
      // The SDK's subpaths: core is the root export; testing, tui and desktop build on it.
      { "name": "sdk-core", "patterns": ["packages/sdk/src/core/**"] },
      { "name": "sdk-testing", "patterns": ["packages/sdk/src/testing/**"] },
      { "name": "sdk-tui", "patterns": ["packages/sdk/src/tui/**"] },
      { "name": "sdk-desktop", "patterns": ["packages/sdk/src/desktop/**"] },
      { "name": "plugins", "patterns": ["packages/plugins/**"] },
      { "name": "tools", "patterns": ["tools/**"] },
    ],
    "rules": [
      // sdk-testing serves only test files; the liminal/testing-imports lint rule enforces that.
      {
        "from": "apps",
        "allow": ["kernel", "sdk-core", "sdk-testing", "sdk-tui", "sdk-desktop", "plugins"],
      },
      { "from": "kernel", "allow": ["sdk-core", "sdk-testing"] },
      { "from": "sdk-core", "allow": [] },
      { "from": "sdk-testing", "allow": ["sdk-core"] },
      { "from": "sdk-tui", "allow": ["sdk-core"] },
      { "from": "sdk-desktop", "allow": ["sdk-core"] },
      {
        "from": "plugins",
        "allow": ["sdk-core", "sdk-testing", "sdk-tui", "sdk-desktop", "plugins"],
      },
      { "from": "tools", "allow": [] },
    ],
  },
}
