{
  "$schema": "./node_modules/fallow/schema.json",
  // Fallow owns dead code, workspace dependency hygiene, cycles, import boundaries and duplicates.
  "ignorePatterns": ["tools/**/fixtures/**", "docs/reference/copies/**", "archive/**"],
  "entry": [
    "tools/quiet.ts",
    "tools/checks/plugin-anatomy.ts",
    "tools/reference/sync.ts",
    "tools/reference/check.ts",
  ],
  // Published APIs: core, the frontend kit and every plugin's contract.
  "publicPackages": ["@shanepadgett/liminal-*"],
  "rules": {
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "type-only-dependencies": "error",
    "test-only-dependencies": "error",
    "dev-dependencies-in-production": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "policy-violation": "error",
  },
  // Layers: each zone imports only the layers below it. First matching zone wins, so base sits
  // before plugins. Runtime-specific imports are banned in .oxlintrc.json, which takes patterns.
  "boundaries": {
    "zones": [
      { "name": "core", "patterns": ["packages/core/**"] },
      {
        "name": "base",
        "patterns": [
          "packages/plugins/{directories,settings,model,session,tools,tool-definitions,system-prompt,persona,history,loop}/**",
        ],
      },
      { "name": "plugins", "patterns": ["packages/plugins/**"] },
      { "name": "client", "patterns": ["packages/client/**"] },
      { "name": "tui", "patterns": ["packages/tui/**"] },
      { "name": "apps", "patterns": ["apps/**"] },
      { "name": "tools", "patterns": ["tools/**"] },
    ],
    "rules": [
      { "from": "core", "allow": [] },
      { "from": "base", "allow": ["core"] },
      { "from": "plugins", "allow": ["core", "base", "tui"] },
      { "from": "client", "allow": ["core", "base", "plugins"] },
      { "from": "tui", "allow": ["core", "client"], "allowTypeOnly": ["base", "plugins"] },
      { "from": "apps", "allow": ["core", "base", "plugins", "client", "tui"] },
      { "from": "tools", "allow": [] },
    ],
    "coverage": { "requireAllFiles": true },
  },
  "duplicates": { "mode": "mild", "minTokens": 50, "minLines": 5, "minOccurrences": 2 },
}
