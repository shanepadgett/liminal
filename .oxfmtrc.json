{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/*.md",
    ".pi/tau/vocabulary.json",
    "docs/reference/copies/**",
    "archive/**"
  ],
  "printWidth": 100,
  "objectWrap": "collapse",
  "experimentalOperatorPosition": "start",
  "jsdoc": true,
  "sortImports": {
    "internalPattern": ["@shanepadgett/liminal-"],
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
