{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["**/*.md", ".pi/tau/vocabulary.json", "docs/reference/copies/**"],
  "printWidth": 100,
  "objectWrap": "collapse",
  "experimentalOperatorPosition": "start",
  "jsdoc": true,
  "sortImports": {
    "internalPattern": ["@liminal/"],
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "unknown"
    ]
  }
}
